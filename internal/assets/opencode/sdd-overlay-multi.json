{
  "agent": {
    "ciberbal": {
      "mode": "primary",
      "description": "Ciberbal — Engagement Orchestrator, coordinates sub-agents, never does work inline",
      "prompt": "{file:./AGENTS.md}",
      "permission": {
        "task": {
          "*": "deny",
          "sdd-*": "allow"
        }
      },
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "delegate": true,
        "delegation_read": true,
        "delegation_list": true
      }
    },
